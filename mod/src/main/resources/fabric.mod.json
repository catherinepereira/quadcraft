{
	"schemaVersion": 1,
	"id": "quadcraft",
	"version": "${version}",
	"name": "Quadcraft",
	"description": "A pilotable drone whose camera and controls are exposed over a local bridge for recording and training.",
	"authors": ["Cat Pereira"],
	"environment": "*",
	"entrypoints": {
		"main": ["com.catherinepereira.quadcraft.Quadcraft"],
		"client": ["com.catherinepereira.quadcraft.client.QuadcraftClient"]
	},
	"mixins": [
		{
			"config": "quadcraft.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.19.5",
		"minecraft": "~26.3",
		"java": ">=25",
		"fabric-api": "*"
	},
	"suggests": {
		"bluemap": "*"
	}
}
